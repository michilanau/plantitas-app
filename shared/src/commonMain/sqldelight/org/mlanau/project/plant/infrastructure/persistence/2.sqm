-- To make notificationTime nullable, we need to recreate the table in SQLite
CREATE TABLE careRuleEntity_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plantId INTEGER NOT NULL,
    type TEXT NOT NULL,
    recurrenceType TEXT NOT NULL,
    everyDays INTEGER,
    startDate TEXT NOT NULL,
    notificationTime TEXT,
    notificationsEnabled INTEGER NOT NULL DEFAULT 1,
    endDate TEXT,
    active INTEGER NOT NULL DEFAULT 1,
    amountMl INTEGER,
    useFilteredWater INTEGER,
    fertilizerName TEXT,
    doseMl INTEGER,
    dilutionRatio TEXT,
    newPotSize TEXT,
    substrateType TEXT,
    FOREIGN KEY (plantId) REFERENCES plantEntity(id) ON DELETE CASCADE
);

INSERT INTO careRuleEntity_new (id, plantId, type, recurrenceType, everyDays, startDate, notificationTime, notificationsEnabled, endDate, active, amountMl, useFilteredWater, fertilizerName, doseMl, dilutionRatio, newPotSize, substrateType)
SELECT id, plantId, type, recurrenceType, everyDays, startDate, notificationTime, 1, endDate, active, amountMl, useFilteredWater, fertilizerName, doseMl, dilutionRatio, newPotSize, substrateType FROM careRuleEntity;

DROP TABLE careRuleEntity;
ALTER TABLE careRuleEntity_new RENAME TO careRuleEntity;
