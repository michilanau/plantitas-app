-- Tables
CREATE TABLE plantEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    location TEXT,
    lightNeed TEXT,
    potSize TEXT,
    createdAt TEXT NOT NULL DEFAULT ""
);

CREATE TABLE careRuleEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plantId INTEGER NOT NULL,
    type TEXT NOT NULL,
    recurrenceType TEXT NOT NULL,
    everyDays INTEGER,
    startDate TEXT NOT NULL,
    notificationTime TEXT NOT NULL,
    endDate TEXT,
    active INTEGER NOT NULL DEFAULT 1,
    amountMl INTEGER,
    useFilteredWater INTEGER,
    fertilizerName TEXT,
    doseMl INTEGER,
    dilutionRatio TEXT,
    newPotSize TEXT,
    substrateType TEXT,
    FOREIGN KEY (plantId) REFERENCES plantEntity(id) ON DELETE CASCADE
);

CREATE TABLE careEventEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    careRuleId INTEGER NOT NULL,
    plantId INTEGER NOT NULL,
    type TEXT NOT NULL,
    scheduledAt TEXT NOT NULL,
    status TEXT NOT NULL,
    completedAt TEXT,
    originalScheduledAt TEXT,
    amountMl INTEGER,
    useFilteredWater INTEGER,
    fertilizerName TEXT,
    doseMl INTEGER,
    dilutionRatio TEXT,
    newPotSize TEXT,
    substrateType TEXT,
    FOREIGN KEY (careRuleId) REFERENCES careRuleEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (plantId) REFERENCES plantEntity(id) ON DELETE CASCADE
);

-- Plant Queries
selectAll:
SELECT * FROM plantEntity;

insertPlant:
INSERT INTO plantEntity(name, description, location, lightNeed, potSize, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updatePlant:
UPDATE plantEntity
SET name = ?, description = ?, location = ?, lightNeed = ?, potSize = ?, createdAt = ?
WHERE id = ?;

selectPlantById:
SELECT * FROM plantEntity WHERE id = ?;

deletePlant:
DELETE FROM plantEntity WHERE id = ?;

-- Care Rule Queries
selectCareRulesByPlantId:
SELECT * FROM careRuleEntity WHERE plantId = ?;

selectAllCareRules:
SELECT * FROM careRuleEntity;

insertCareRule:
INSERT INTO careRuleEntity(plantId, type, recurrenceType, everyDays, startDate, notificationTime, endDate, active, amountMl, useFilteredWater, fertilizerName, doseMl, dilutionRatio, newPotSize, substrateType)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCareRule:
UPDATE careRuleEntity
SET plantId = ?, type = ?, recurrenceType = ?, everyDays = ?, startDate = ?, notificationTime = ?, endDate = ?, active = ?, amountMl = ?, useFilteredWater = ?, fertilizerName = ?, doseMl = ?, dilutionRatio = ?, newPotSize = ?, substrateType = ?
WHERE id = ?;

deleteCareRule:
DELETE FROM careRuleEntity WHERE id = ?;

-- Care Event Queries
selectCareEventsInRange:
SELECT * FROM careEventEntity WHERE scheduledAt BETWEEN ? AND ?;

selectCareEventsByPlantIdInRange:
SELECT * FROM careEventEntity WHERE plantId = ? AND scheduledAt BETWEEN ? AND ?;

selectCareEventsByRuleId:
SELECT * FROM careEventEntity WHERE careRuleId = ?;

selectNextCareEventByPlantId:
SELECT * FROM careEventEntity
WHERE plantId = ? AND status = 'PENDING' AND scheduledAt >= ?
ORDER BY scheduledAt ASC
LIMIT 1;

insertCareEvent:
INSERT INTO careEventEntity(careRuleId, plantId, type, scheduledAt, status, completedAt, originalScheduledAt, amountMl, useFilteredWater, fertilizerName, doseMl, dilutionRatio, newPotSize, substrateType)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCareEventStatus:
UPDATE careEventEntity SET status = ?, completedAt = ? WHERE id = ?;

deleteCareEvent:
DELETE FROM careEventEntity WHERE id = ?;
