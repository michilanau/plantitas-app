-- Tables
CREATE TABLE plantEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    location TEXT,
    lightNeed TEXT,
    potSize TEXT,
    imageUrl TEXT,
    createdAt TEXT NOT NULL DEFAULT ""
);

CREATE TABLE careRuleEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plantId INTEGER NOT NULL,
    type TEXT NOT NULL,
    recurrenceType TEXT NOT NULL,
    everyDays INTEGER,
    startDate TEXT NOT NULL,
    notificationTime TEXT,
    notificationsEnabled INTEGER NOT NULL DEFAULT 1,
    endDate TEXT,
    active INTEGER NOT NULL DEFAULT 1,
    -- Suppresses every occurrence at or before this instant. Moved forward when the user
    -- dismisses a scheduled or overdue occurrence; independent of the anchor below, which
    -- comes from careLogEntity and tracks the actual care rhythm, not what was dismissed.
    dismissedBefore TEXT,
    amountMl INTEGER,
    useFilteredWater INTEGER,
    fertilizerName TEXT,
    doseMl INTEGER,
    dilutionRatio TEXT,
    newPotSize TEXT,
    substrateType TEXT,
    FOREIGN KEY (plantId) REFERENCES plantEntity(id) ON DELETE CASCADE
);

-- A care that actually happened: the factual counterpart to a CareRule's still-virtual
-- occurrences. A log is not tied to a specific planned occurrence and outlives the rule that
-- (maybe) produced it: careRuleId is
-- nullable and SET NULL on delete, so a plant's care history survives deleting or recreating its
-- rules. scheduledAt is nullable too, since a log can be entered ad hoc for a day that never had
-- a planned occurrence. The scheduling anchor for a (plant, type) is derived as
-- MAX(performedAt) grouped by (plantId, type) — see careLog_plant_type_performedAt below — rather
-- than stored anywhere, so it can never drift out of sync with the log itself.
CREATE TABLE careLogEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plantId INTEGER NOT NULL,
    careRuleId INTEGER,
    type TEXT NOT NULL,
    performedAt TEXT NOT NULL,
    scheduledAt TEXT,
    note TEXT,
    amountMl INTEGER,
    useFilteredWater INTEGER,
    fertilizerName TEXT,
    doseMl INTEGER,
    dilutionRatio TEXT,
    newPotSize TEXT,
    substrateType TEXT,
    FOREIGN KEY (careRuleId) REFERENCES careRuleEntity(id) ON DELETE SET NULL,
    FOREIGN KEY (plantId) REFERENCES plantEntity(id) ON DELETE CASCADE
);

-- Serves MAX(performedAt) GROUP BY (plantId, type) directly (the anchor lookup) and orders a
-- plant's history query.
CREATE INDEX careLog_plant_type_performedAt ON careLogEntity(plantId, type, performedAt);

-- Plant Queries
selectAll:
SELECT * FROM plantEntity;

insertPlant:
INSERT INTO plantEntity(name, description, location, lightNeed, potSize, imageUrl, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updatePlant:
UPDATE plantEntity
SET name = ?, description = ?, location = ?, lightNeed = ?, potSize = ?, imageUrl = ?, createdAt = ?
WHERE id = ?;

selectPlantById:
SELECT * FROM plantEntity WHERE id = ?;

deletePlant:
DELETE FROM plantEntity WHERE id = ?;

-- Care Rule Queries
selectCareRulesByPlantId:
SELECT * FROM careRuleEntity WHERE plantId = ?;

selectAllCareRules:
SELECT * FROM careRuleEntity;

selectCareRuleById:
SELECT * FROM careRuleEntity WHERE id = ?;

insertCareRule:
INSERT INTO careRuleEntity(plantId, type, recurrenceType, everyDays, startDate, notificationTime, notificationsEnabled, endDate, active, dismissedBefore, amountMl, useFilteredWater, fertilizerName, doseMl, dilutionRatio, newPotSize, substrateType)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCareRule:
UPDATE careRuleEntity
SET plantId = ?, type = ?, recurrenceType = ?, everyDays = ?, startDate = ?, notificationTime = ?, notificationsEnabled = ?, endDate = ?, active = ?, dismissedBefore = ?, amountMl = ?, useFilteredWater = ?, fertilizerName = ?, doseMl = ?, dilutionRatio = ?, newPotSize = ?, substrateType = ?
WHERE id = ?;

updateCareRuleDismissedBefore:
UPDATE careRuleEntity SET dismissedBefore = ? WHERE id = ?;

deleteCareRule:
DELETE FROM careRuleEntity WHERE id = ?;

-- Care Log Queries
selectCareLogsByPlantId:
SELECT * FROM careLogEntity WHERE plantId = ? ORDER BY performedAt DESC;

selectCareLogsInRange:
SELECT * FROM careLogEntity WHERE performedAt BETWEEN ? AND ?;

selectCareLogById:
SELECT * FROM careLogEntity WHERE id = ?;

-- The anchor for every (plant, type) in one aggregated query, so a screen that loads all rules
-- for all plants (the calendar) doesn't need one query per plant.
selectLastCareByPlantAndType:
SELECT plantId, type, MAX(performedAt) AS lastPerformedAt
FROM careLogEntity
GROUP BY plantId, type;

selectLastCareByTypeForPlant:
SELECT plantId, type, MAX(performedAt) AS lastPerformedAt
FROM careLogEntity
WHERE plantId = ?
GROUP BY plantId, type;

insertCareLog:
INSERT INTO careLogEntity(plantId, careRuleId, type, performedAt, scheduledAt, note, amountMl, useFilteredWater, fertilizerName, doseMl, dilutionRatio, newPotSize, substrateType)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCareLog:
DELETE FROM careLogEntity WHERE id = ?;
